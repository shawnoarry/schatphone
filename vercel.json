{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/openai/v1/chat/completions.js": {
      "maxDuration": 60
    },
    "api/openai/v1/models.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/openai/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
