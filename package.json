{
  "name": "schatphone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "assets:prepare": "node scripts/imgbed-publish.mjs prepare",
    "assets:publish": "node scripts/imgbed-publish.mjs publish",
    "assets:check": "node scripts/imgbed-publish.mjs check",
    "imgbed:registry-sync": "node scripts/imgbed-publish.mjs import-migration",
    "imgbed:archive": "node scripts/imgbed-archive.mjs archive",
    "imgbed:archive-remove": "node scripts/imgbed-archive.mjs remove",
    "imgbed:inventory": "node scripts/imgbed-migration.mjs inventory",
    "imgbed:plan": "node scripts/imgbed-migration.mjs plan",
    "imgbed:plan-all": "node scripts/imgbed-migration.mjs plan-all",
    "imgbed:preflight": "node scripts/imgbed-migration.mjs preflight",
    "imgbed:upload": "node scripts/imgbed-migration.mjs upload",
    "dev": "vite",
    "build": "vite build",
    "build:github": "vite build --mode github",
    "build:vercel": "vite build --mode vercel --base /",
    "build:cloudflare": "vite build --mode cloudflare --base /",
    "preview": "vite preview",
    "push:server": "node server/push-server.mjs",
    "push:keys": "node server/generate-vapid.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test e2e/visual-quality.spec.js",
    "governance:check": "vitest run tests/workflow-governance.test.js tests/mojibake-guard.test.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.0.0",
    "marked": "^17.0.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-router": "^5.0.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.16.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.9.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.12.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "wrangler": "4.120.0"
  }
