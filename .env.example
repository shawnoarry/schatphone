VITE_API_PROVIDER=openai
VITE_API_URL=https://api.openai.com/v1/chat/completions
VITE_API_MODEL=gpt-4o-mini
VITE_API_KEY=your_key_here
VITE_SCHATPHONE_AI_PROXY_URL=https://schatphone.noarry.workers.dev/api/openai/v1
VITE_ENABLE_LAYOUT_EDIT=false
VITE_PUSH_SERVER_URL=http://localhost:8787
VITE_APP_VERSION=1.2.0

# Local image-bed migration tooling. Keep the real token only in ignored .env.local.
SCHATPHONE_IMGBED_BASE_URL=https://cloudflare-imgbed-7z3.pages.dev
SCHATPHONE_IMGBED_TOKEN=
# Long-lived project publisher credential. Grant upload + list only; do not grant delete/manage.
# On every publishing workstation, retrieve the same value from the owner's password-manager
# entry named SchatPhone-Project-Publisher and store it only in that workstation's ignored .env.local.
SCHATPHONE_IMGBED_PROJECT_TOKEN=

# Restricted per-request OpenAI-compatible relay. `public` requires an allowed browser origin
# (or same-origin Fetch Metadata); `token` additionally requires SCHATPHONE_AI_PROXY_CLIENT_TOKEN
# through X-SchatPhone-Proxy-Token.
SCHATPHONE_AI_PROXY_DYNAMIC_MODE=public
SCHATPHONE_AI_PROXY_ALLOWED_ORIGINS=http://localhost:5173,https://schatphone.vercel.app
SCHATPHONE_AI_PROXY_RATE_LIMIT_PER_MINUTE=60
SCHATPHONE_AI_PROXY_TIMEOUT_MS=30000

# Legacy fixed-upstream personal relay. These remain optional and server-only.
SCHATPHONE_AI_PROXY_UPSTREAM_URL=https://provider.example/v1
SCHATPHONE_AI_PROXY_UPSTREAM_KEY=replace_with_upstream_key
SCHATPHONE_AI_PROXY_CLIENT_TOKEN=replace_with_long_random_client_token
SCHATPHONE_AI_PROXY_ALLOW_KEYLESS=false
