{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schatphone",
  "main": "server/cloudflare-worker.mjs",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
