{
  "fixtureSchemaVersion": 1,
  "id": "kpop-realism-first-vertical-slice-contract-v1",
  "mapPlaceSessionCheckpoint": {
    "schemaVersion": 1,
    "recordType": "map_place_session",
    "checkpointId": "map.place_session.entered.v1",
    "requiredFields": [
      "sessionId",
      "revision",
      "state",
      "worldPackId",
      "mapPackId",
      "mapPackVersion",
      "placeId",
      "placeCategoryId",
      "capabilityIds",
      "enteredAt",
      "updatedAt",
      "presence.relation",
      "presence.provenance",
      "presence.evidenceAt"
    ],
    "allowedState": "inside",
    "allowedPresenceRelation": "inside",
    "acceptedPositionProvenance": ["manual", "journey_arrival"],
    "journeyArrivalEvidence": ["journeyId", "journeyArrivedAt"],
    "legacySourceTranslation": {
      "map_point": "manual",
      "map_pack": "manual",
      "saved": "manual",
      "trip_arrived": "journey_arrival"
    },
    "legacyTranslationRules": [
      "A stable placeId and current map-pack match are always required.",
      "trip_arrived is accepted only when the matching arrived journey still proves the destination place.",
      "Legacy source text alone never proves inside presence.",
      "Unknown or stale evidence fails closed."
    ]
  },
  "eventTemplate": {
    "schemaVersion": 2,
    "id": "workplace.arrival_briefing",
    "version": 1,
    "archetypeId": "arrival_briefing",
    "owner": {
      "sourceModuleKey": "map",
      "effectModuleKey": "map"
    },
    "source": {
      "recordType": "map_place_session",
      "checkpointId": "map.place_session.entered.v1"
    },
    "trigger": {
      "modes": ["condition"],
      "activationScope": "interior",
      "discoverability": "hidden_until_eligible",
      "probability": 1,
      "cooldownMs": 21600000,
      "dailyLimit": 1,
      "targetScope": "place_id",
      "modulePermissionKey": "map",
      "intensityPolicy": "enabled_when_not_off"
    },
    "eligibility": {
      "requiredPlaceCategoryIds": [
        "broadcast_station",
        "entertainment_agency",
        "production_center"
      ],
      "requiredCapabilityIds": ["work", "wait"],
      "acceptedPositionProvenance": ["manual", "journey_arrival"],
      "requiredPlaceSessionState": "inside",
      "conditions": [
        { "key": "placeSession.state", "op": "eq", "value": "inside" },
        { "key": "placeSession.revision", "op": "gt", "value": 0 }
      ]
    },
    "presentation": {
      "surfaceKeys": ["map.event_invitation", "map.event_detail"],
      "expansionKind": "host_detail",
      "textMaterializationMode": "optional_ai_after_entry",
      "mediaIntentKey": "workplace.arrival_briefing.lobby"
    },
    "choices": [
      {
        "id": "review_brief",
        "outcomeId": "brief_reviewed",
        "effectRequest": {
          "adapterKey": "map.place_session.validate_event_resolution",
          "payloadSchema": "MapPlaceSessionEventResolutionRequestV1"
        }
      },
      {
        "id": "check_equipment",
        "outcomeId": "equipment_checked",
        "effectRequest": {
          "adapterKey": "map.place_session.validate_event_resolution",
          "payloadSchema": "MapPlaceSessionEventResolutionRequestV1"
        }
      },
      {
        "id": "wait_for_staff",
        "outcomeId": "wait_acknowledged",
        "effectRequest": {
          "adapterKey": "map.place_session.validate_event_resolution",
          "payloadSchema": "MapPlaceSessionEventResolutionRequestV1"
        }
      }
    ],
    "safety": {
      "risk": "low",
      "requiresAdditionalConfirmation": false,
      "reversibleExternalMutation": true,
      "externalMutation": "none",
      "relationshipGatePresetId": ""
    }
  },
  "mapResolutionAdapter": {
    "adapterKey": "map.place_session.validate_event_resolution",
    "requestSchema": "MapPlaceSessionEventResolutionRequestV1",
    "requiredRequestFields": [
      "authorization",
      "eventInstanceId",
      "sessionId",
      "sessionRevision",
      "mapPackId",
      "placeId",
      "choiceId",
      "outcomeId"
    ],
    "authorizationValue": "event_runtime_choice",
    "allowedChoiceIds": ["review_brief", "check_equipment", "wait_for_staff"],
    "allowedOutcomeIds": [
      "brief_reviewed",
      "equipment_checked",
      "wait_acknowledged"
    ],
    "successResult": {
      "ok": true,
      "code": "PLACE_SESSION_EVENT_RESOLUTION_VALID",
      "canonicalMutation": "none"
    },
    "failureCodes": [
      "PLACE_SESSION_NOT_ACTIVE",
      "PLACE_SESSION_SOURCE_STALE",
      "PLACE_SESSION_PLACE_MISMATCH",
      "EVENT_CHOICE_UNSUPPORTED",
      "EVENT_OUTCOME_UNSUPPORTED",
      "EVENT_AUTHORIZATION_INVALID"
    ]
  },
